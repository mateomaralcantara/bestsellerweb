# URL pública
NEXT_PUBLIC_SITE_URL=https://www.libroseller.com

# Supabase: la publishable puede exponerse; la secret/service role nunca
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REEMPLAZAR

# Cloudflare Turnstile: solo la Site Key es pública. El Secret se configura
# directamente en Supabase Auth, nunca en el navegador ni en este repositorio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REEMPLAZAR

# PayPal
PAYPAL_CLIENT_ID=REEMPLAZAR
PAYPAL_CLIENT_SECRET=REEMPLAZAR
PAYPAL_WEBHOOK_ID=REEMPLAZAR
PAYPAL_ENV=live
PAYPAL_DEFAULT_CURRENCY=USD

# Protección de abuso (mínimo 32 caracteres aleatorios)
RATE_LIMIT_SECRET=REEMPLAZAR_CON_VALOR_ALEATORIO_DISTINTO
HEALTHCHECK_SECRET=REEMPLAZAR_CON_VALOR_ALEATORIO_DISTINTO

async function tryUpdatePreviewStatus(
  bookId: RecordId,
  status: PreviewStatus,
  errorMessage?: string
) {
  const patch: Record<string, string | null> = {
    preview_status: status,
    preview_error: status === "error" ? errorMessage ?? "No se pudo generar la muestra" : null,
  };

  if (status === "ready") {
    patch.preview_generated_at = new Date().toISOString();
  }

  const { error } = await supabaseAdmin.from("books").update(patch).eq("id", bookId);

  if (error) {
    console.warn("No se pudo actualizar preview_status en books:", error.message);
  }
}

async function clearPreviewPages(bookId: RecordId) {
  const { error } = await supabaseAdmin
    .from("book_preview_pages")
    .delete()
    .eq("book_id", bookId);

  if (error) {
    throw new Error(`Error limpiando páginas de preview: ${error.message}`);
  }
}

async function insertPreviewPage(params: {
  bookId: RecordId;
  pageIndex: number;
  sourcePageNumber: number | null;
  kind: PreviewKind;
  imagePath: string;
  imageUrl: string | null;
  imageWidth: number | null;
  imageHeight: number | null;
}) {
  const { error } = await supabaseAdmin.from("book_preview_pages").upsert(
    {
      book_id: params.bookId,
      page_index: params.pageIndex,
      source_page_number: params.sourcePageNumber,
      kind: params.kind,
      image_path: params.imagePath,
      image_url: params.imageUrl,
      ["width"]: params.imageWidth,
      ["height"]: params.imageHeight,
    },
    { onConflict: "book_id,page_index" }
  );

  if (error) {
    throw new Error(`Error guardando página de preview: ${error.message}`);
  }
}

async function uploadCoverAsPreview(params: {
  bookId: RecordId;
  slug: string;
  cover: File;
}): Promise<{ path: string; publicUrl: string; imageWidth: number | null; imageHeight: number | null }> {
  const ext = getMimeExtension(params.cover, "jpg");
  const path = `previews/${params.slug}-${params.bookId}/page-000.${ext}`;
  const buffer = Buffer.from(await params.cover.arrayBuffer());

  const uploaded = await uploadBuffer({
    bucket: PREVIEW_BUCKET,
    storagePath: path,
    buffer,
    contentType: params.cover.type || "image/jpeg",
    upsert: true,
  });

  return {
    path: uploaded.path,
    publicUrl: uploaded.publicUrl,
    imageWidth: null,
    imageHeight: null,
  };
}

async function canvasToPngBuffer(canvas: unknown): Promise<Buffer> {
  const maybeCanvas = canvas as {
    encode?: (format: string) => Promise<Buffer> | Buffer;
    toBuffer?: (mimeType?: string) => Buffer;
  };

  if (typeof maybeCanvas.encode === "function") {
    const encoded = await maybeCanvas.encode("png");
    return Buffer.isBuffer(encoded) ? encoded : Buffer.from(encoded);
  }

  if (typeof maybeCanvas.toBuffer === "function") {
    return maybeCanvas.toBuffer("image/png");
  }

  throw new Error("No se pudo convertir la página PDF a imagen PNG");
}

async function renderPdfPreviewPages(params: {
  bookId: RecordId;
  slug: string;
  pdfFile: File;
  startPageIndex: number;
  pageCount: number;
}): Promise<{ paths: string[]; renderedPages: number }> {
  const ext = getExtension(params.pdfFile.name);
  if (ext !== "pdf") {
    return { paths: [], renderedPages: 0 };
  }

  const [{ getDocument }, canvasModule] = await Promise.all([
    import("pdfjs-dist/legacy/build/pdf.mjs"),
    import("@napi-rs/canvas"),
  ]);

  const createCanvas = (canvasModule as { createCanvas: (width: number, height: number) => unknown })
    .createCanvas;

  const pdfData = new Uint8Array(await params.pdfFile.arrayBuffer());

  const loadingTask = getDocument({
    data: pdfData,
    useSystemFonts: true,
  });

  const pdf = await loadingTask.promise;
  const totalPages = Math.min(params.pageCount, pdf.numPages);
  const paths: string[] = [];

  for (let sourcePageNumber = 1; sourcePageNumber <= totalPages; sourcePageNumber += 1) {
    const page = await pdf.getPage(sourcePageNumber);
    const viewport = page.getViewport({ scale: PDF_RENDER_SCALE });
    const imageWidth = Math.ceil(viewport.width);
    const imageHeight = Math.ceil(viewport.height);
    const canvas = createCanvas(imageWidth, imageHeight);
    const context = (canvas as { getContext: (contextId: "2d") => unknown }).getContext("2d");

    await page.render({
      canvas: canvas as never,
      canvasContext: context as never,
      viewport,
    } as never).promise;

    const buffer = await canvasToPngBuffer(canvas);
    const pageIndex = params.startPageIndex + sourcePageNumber - 1;
    const imagePath = `previews/${params.slug}-${params.bookId}/page-${String(pageIndex).padStart(
      3,
      "0"
    )}.png`;

    const uploaded = await uploadBuffer({
      bucket: PREVIEW_BUCKET,
      storagePath: imagePath,
      buffer,
      contentType: "image/png",
      upsert: true,
    });

    await insertPreviewPage({
      bookId: params.bookId,
      pageIndex,
      sourcePageNumber,
      kind: "pdf_page",
      imagePath: uploaded.path,
      imageUrl: uploaded.publicUrl,
      imageWidth,
      imageHeight,
    });

    paths.push(uploaded.path);
    page.cleanup?.();
  }

  await pdf.destroy?.();

  return { paths, renderedPages: totalPages };
}

async function generateVisualPreview(params: {
  bookId: RecordId;
  slug: string;
  form: UploadBookForm;
}): Promise<PreviewGenerationResult> {
  if (params.form.previewMode === "disabled") {
    return { status: "unsupported", pageCount: 0, paths: [] };
  }

  await tryUpdatePreviewStatus(params.bookId, "generating");
  await clearPreviewPages(params.bookId);

  const paths: string[] = [];
  let nextPageIndex = 0;

  if (params.form.previewIncludeCover) {
    const coverPreview = await uploadCoverAsPreview({
      bookId: params.bookId,
      slug: params.slug,
      cover: params.form.cover,
    });

    await insertPreviewPage({
      bookId: params.bookId,
      pageIndex: 0,
      sourcePageNumber: null,
      kind: "cover",
      imagePath: coverPreview.path,
      imageUrl: coverPreview.publicUrl,
      imageWidth: coverPreview.imageWidth,
      imageHeight: coverPreview.imageHeight,
    });

    paths.push(coverPreview.path);
    nextPageIndex = 1;
  }

  if (getExtension(params.form.bookFile.name) !== "pdf") {
    const message = "La muestra automática por páginas solo está activa para PDF.";

    await tryUpdatePreviewStatus(
      params.bookId,
      paths.length ? "ready" : "error",
      message
    );

    return {
      status: paths.length ? "ready" : "unsupported",
      pageCount: paths.length,
      paths,
      error: paths.length
        ? "El archivo no es PDF; solo se generó portada como muestra."
        : message,
    };
  }

  const rendered = await renderPdfPreviewPages({
    bookId: params.bookId,
    slug: params.slug,
    pdfFile: params.form.bookFile,
    startPageIndex: nextPageIndex,
    pageCount: params.form.previewPageCount,
  });

  paths.push(...rendered.paths);
  await tryUpdatePreviewStatus(params.bookId, paths.length ? "ready" : "error");

  return {
    status: paths.length ? "ready" : "error",
    pageCount: paths.length,
    paths,
  };
}

export async function POST(request: Request) {
  const rollbackState: RollbackState = {
    bookId: null,
    editionId: null,
    coverPath: null,
    filePath: null,
    previewPaths: [],
  };

  try {
    const effectiveUser = await getEffectiveUser();
    const authorId = await getOrCreateAuthorProfile(effectiveUser);

    const formData = await request.formData();
    const form = parseAndValidateForm(formData);

    const slug = await generateUniqueSlug(form.title);
    const coverExt = getMimeExtension(form.cover, "jpg");
    const bookExt = getMimeExtension(form.bookFile, "pdf");
    const bookAssetType = getBookAssetType(form.bookFile.name);

    const coverPath = `covers/${slug}-${randomUUID()}.${coverExt}`;
    const filePath = `books/${slug}-${randomUUID()}.${bookExt}`;

    rollbackState.coverPath = coverPath;
    rollbackState.filePath = filePath;

    await Promise.all([
      uploadFile({
        bucket: COVER_BUCKET,
        storagePath: coverPath,
        file: form.cover,
      }),
      uploadFile({
        bucket: FILE_BUCKET,
        storagePath: filePath,
        file: form.bookFile,
      }),
    ]);

    const coverUrl = getPublicUrl(COVER_BUCKET, coverPath);

    const insertedBook = await createBookRecord({
      ownerUserId: effectiveUser.id,
      authorId,
      form,
      slug,
      coverUrl,
      descriptionLong: form.descriptionInput,
      introduction: form.introductionInput || null,
      chapterOne: form.chapterOneInput || null,
    });

    rollbackState.bookId = insertedBook.id;

    const insertedEdition = await createEditionRecord({
      bookId: insertedBook.id,
      form,
    });

    rollbackState.editionId = insertedEdition.id;

    await createAssetRecords({
      bookId: insertedBook.id,
      editionId: insertedEdition.id,
      coverPath,
      filePath,
      coverUrl,
      coverMimeType: form.cover.type || null,
      fileMimeType: form.bookFile.type || null,
      bookAssetType,
    });

    let preview: PreviewGenerationResult = {
      status: "unsupported",
      pageCount: 0,
      paths: [],
    };

    try {
      preview = await generateVisualPreview({
        bookId: insertedBook.id,
        slug,
        form,
      });

      rollbackState.previewPaths = preview.paths;
    } catch (previewError) {
      const previewMessage = getErrorMessage(previewError);

      console.error("Error generando preview visual:", previewError);

      await tryUpdatePreviewStatus(insertedBook.id, "error", previewMessage);

      preview = {
        status: "error",
        pageCount: 0,
        paths: [],
        error: previewMessage,
      };
    }

    return Response.json(
      {
        message:
          form.status === "draft"
            ? "Libro guardado como borrador"
            : "Libro enviado a evaluación correctamente",
        book: insertedBook,
        edition: insertedEdition,
        storage: {
          cover_path: coverPath,
          file_path: filePath,
          cover_url: coverUrl,
        },
        preview,
        view_url: `/dashboard/books/${insertedBook.id}/edit`,
        dev_mode: DEV_MODE,
      },
      { status: 201 }
    );
  } catch (error) {
    console.error("POST /api/books error:", error);

    await rollback(rollbackState);

    const message = getErrorMessage(error);

    return jsonError(message, resolveErrorStatus(message));
  }
}

{
    "name":  "bestseller-platform",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "clean":  "powershell -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next }\"",
                    "dev":  "next dev --webpack -p 3000",
                    "dev:clean":  "npm run clean && next dev --webpack -p 3000",
                    "build":  "next build --webpack",
                    "start":  "next start",
                    "verify:book-preview":  "node scripts/verify-book-preview.cjs",
                    "smoke:book-upload":  "node scripts/smoke-test-book-upload.cjs",
                    "test:book-preview-direct":  "node scripts/test-book-preview-direct.mjs",
                    "diagnose:catalog-route":  "node scripts/diagnose-catalog-route.cjs",
                    "check:parallel-routes":  "node scripts/check-parallel-routes.cjs",
                    "diagnose:routing":  "node scripts/diagnose-routing.cjs",
                    "audit:project":  "node scripts/audit-project.mjs",
                    "preview:book":  "node scripts/generate-book-preview.mjs",
                    "debug:book-api":  "node scripts/debug-book-api-route.mjs",
                    "debug:book-cover":  "node scripts/debug-book-cover-preview.mjs",
                    "repair:catalog":  "node scripts/repair-catalog-page-escapes.mjs",
                    "fix:books-route":  "node scripts/fix-books-route-no-native-preview.mjs",
                    "preview:missing":  "node scripts/generate-missing-book-previews.mjs",
                    "env:vercel":  "node scripts/list-vercel-env.mjs",
                    "verify:epub-preview":  "node scripts/verify-epub-preview.mjs",
                    "preview:book:local-pdf":  "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-book-preview.ps1",
                    "lint":  "eslint .",
                    "lint:strict":  "eslint . --max-warnings=0",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "@napi-rs/canvas":  "^1.0.0",
                         "@supabase/ssr":  "^0.10.0",
                         "@supabase/supabase-js":  "^2.107.0",
                         "clsx":  "^2.1.1",
                         "dotenv":  "^17.4.2",
                         "epubjs":  "^0.3.93",
                         "jszip":  "^3.10.1",
                         "lucide-react":  "^0.511.0",
                         "next":  "^16.3.2",
                         "pdf-poppler":  "^0.2.3",
                         "pdfjs-dist":  "^6.2.108",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8",
                         "tailwind-merge":  "^2.6.1"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.7.4",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "autoprefixer":  "^10.4.20",
                            "eslint":  "^9.39.5",
                            "eslint-config-next":  "^16.3.2",
                            "postcss":  "^8.4.47",
                            "tailwindcss":  "^3.4.13",
                            "typescript":  "^5.6.2",
                            "vitest":  "^4.1.11"
                        },
    "overrides":  {
                      "@xmldom/xmldom":  "0.8.14"
                  }
}